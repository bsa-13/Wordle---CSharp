<Window x:Class="WordleGame.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Statistics" Height="350" Width="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Statistics" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TotalGamesText"/>
        <TextBlock x:Name="GamesWonText"/>
        <TextBlock x:Name="WinRateText"/>
        <TextBlock x:Name="CurrentStreakText"/>
        <TextBlock x:Name="MaxStreakText"/>
        <TextBlock Text="Guess Distribution:" Margin="0,20,0,5"/>
        <ItemsControl x:Name="GuessDistributionList"/>
    </StackPanel>
</Window>

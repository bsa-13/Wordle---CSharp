<Window x:Class="WordleGame.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="200" Width="300">
    <StackPanel Margin="20">
        <CheckBox x:Name="SoundCheckbox" Content="Enable Sound" />
        <ComboBox x:Name="ThemeSelector">
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="Dark"/>
        </ComboBox>
        <Button Content="Save" Click="OnSaveClicked" Margin="0,20,0,0"/>
    </StackPanel>
</Window>

